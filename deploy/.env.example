# The Console is the authoritative cash ledger. Both gateways must reach this exact HTTPS origin.
ZEO_NEXUS_CONSOLE_CONTROL_URL=https://ai.zeotrue.com
ZEO_NEXUS_CONSOLE_ALLOW_HTTP=false
ALPINE_MIRROR=
GOPROXY=https://proxy.golang.org,direct
ZEO_NEXUS_CONTROL_SECRET=replace-with-at-least-32-random-characters
ZEO_NEXUS_MASTER_KEY=replace-with-an-independent-32-character-secret
ZEO_NEXUS_SESSION_SECRET=replace-with-an-independent-random-secret
MYSQL_ROOT_PASSWORD=replace-with-a-random-root-password
MYSQL_PASSWORD=replace-with-a-random-application-password
ZEO_NEXUS_AGGREGATION_UPSTREAM_HOSTS=api.deepseek.com,dashscope.aliyuncs.com
ZEO_NEXUS_INFERENCE_UPSTREAM_HOSTS=maizheng.stack.zeotrue.com
# The current GPUStack origin is http://maizheng.stack.zeotrue.com:8090.
# Change this to false after the origin is terminated with HTTPS.
ZEO_NEXUS_INFERENCE_ALLOW_INSECURE_HTTP=true

# Public client domains are terminated by Nginx/WAF; see deploy/nginx/zeonexus-gateway.conf.example.
# Aggregation: https://oneapi.zeotrue.com
# Inference: https://stack.zeotrue.com
