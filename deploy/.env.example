ALPINE_MIRROR=
GOPROXY=https://proxy.golang.org,direct
ZEO_NEXUS_CONTROL_SECRET=replace-with-at-least-32-random-characters
ZEO_NEXUS_MASTER_KEY=replace-with-an-independent-32-character-secret
ZEO_NEXUS_SESSION_SECRET=replace-with-an-independent-random-secret
MYSQL_ROOT_PASSWORD=replace-with-a-random-root-password
MYSQL_PASSWORD=replace-with-a-random-application-password
ZEO_NEXUS_AGGREGATION_UPSTREAM_HOSTS=api.openai.com,api.deepseek.com,commercial-provider.example
ZEO_NEXUS_INFERENCE_UPSTREAM_HOSTS=sh-inference.internal,gy-inference.internal
ZEO_NEXUS_INFERENCE_ALLOW_INSECURE_HTTP=false

# Public client domains are terminated by Nginx/WAF; see deploy/nginx/zeonexus-gateway.conf.example.
# Aggregation: https://stack.zeotrue.com
# Inference: https://compute.zeotrue.com
